<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>SwarmUI-SharpSplat</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <Import Project="../../SwarmUI.extension.props" />

  <ItemGroup Condition="Exists('../../SwarmUI.csproj')">
    <Reference Remove="SwarmUI" />
    <ProjectReference Include="../../SwarmUI.csproj">
      <Private>false</Private>
      <Properties>_EnableMacOSCodeSign=false;StaticWebAssetsEnabled=false</Properties>
      <GlobalPropertiesToRemove>BaseIntermediateOutputPath;TargetName</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="**/._*" />
  </ItemGroup>

  <ItemGroup>
    <!-- API-format adaptation of Comfy-Org/workflow_templates: templates/3d_pixal3d_trellis2_image_to_model.json -->
    <EmbeddedResource Include="Workflows/3d_pixal3d_trellis2_image_to_model.api.json" LogicalName="SharpSplat.Workflows.Native3DImageToModel" />
  </ItemGroup>

</Project>
